{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/webhook",
      "headers": [
        {
          "key": "x-vercel-body-parser",
          "value": "false"
        }
      ]
    }
  ]
}
